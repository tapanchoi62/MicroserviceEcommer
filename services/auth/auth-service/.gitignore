# ─────────────────────────────────────────────
# Auth Service .gitignore
# NestJS + Prisma + PostgreSQL + Redis
# ─────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build ──────────────────────────────────────
dist/
build/

# ── Environment Variables ──────────────────────
.env
.env.local
.env.development
.env.staging
.env.production
.env.*.local
!.env.example

# ── Prisma ─────────────────────────────────────
# Keep schema.prisma & seed, ignore generated migrations in dev
# (Remove this line if you want to commit migrations)
# prisma/migrations/

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Testing & Coverage ─────────────────────────
coverage/
.nyc_output/
test-results/

# ── TypeScript ─────────────────────────────────
*.tsbuildinfo

# ── OS Generated ───────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ── IDE & Editors ──────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Docker local overrides ─────────────────────
docker-compose.override.yml
docker-compose.local.yml

# ── Misc ───────────────────────────────────────
*.pem
*.key
.cache/
tmp/
