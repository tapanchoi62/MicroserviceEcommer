# ══════════════════════════════════════════════════════
#  Auth Service — Environment Variables Template
#  Copy file này → .env và điền giá trị thực
# ══════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1

# ── Database (PostgreSQL riêng cho auth-service) ──────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# ── Rate Limiting ─────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ── OAuth — Google ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ── OAuth — GitHub ────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# ── Frontend ──────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Kafka ─────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=auth-service
KAFKA_GROUP_ID=auth-service-group

# ── gRPC ──────────────────────────────────────────────
GRPC_PORT=50051
GRPC_HOST=localhost

# ── Swagger ───────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=debug

# ── Health Check ──────────────────────────────────────
HEALTH_CHECK_PATH=/api/v1/auth/health
